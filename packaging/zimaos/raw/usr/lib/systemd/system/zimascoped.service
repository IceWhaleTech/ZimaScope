[Unit]
Description=Z-Scope network observability agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=ZIMASCOPE_HTTP_LISTEN=0.0.0.0:41582
Environment=ZIMASCOPE_DATABASE=/var/lib/casaos/zimascope/zimascope.db
Environment=ZIMASCOPE_GEOIP_DATABASE=/usr/share/zimascope/geoip
ExecStartPre=/bin/mkdir -p /var/lib/casaos/zimascope
ExecStart=/usr/bin/zimascoped
Restart=on-failure
RestartSec=2
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
